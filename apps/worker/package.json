{
	"name": "@workspace/worker",
	"version": "0.7.11",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "tsx --env-file=../web/.env --import ./src/instrument.ts src/index.ts",
		"start": "tsx --import ./src/instrument.ts src/index.ts",
		"build": "tsc -p tsconfig.json",
		"check-types": "tsc --noEmit",
		"test": "vitest run --project=unit",
		"test:integration": "vitest run --project=integration"
	},
	"dependencies": {
		"@sentry/node": "^11.11.0",
		"@workspace/config": "workspace:*",
		"@workspace/deployment": "workspace:*",
		"@workspace/lib": "workspace:*",
		"auth0": "catalog:",
		"drizzle-orm": "catalog:",
		"pg": "catalog:",
		"pg-boss": "catalog:",
		"posthog-node": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
