		"pg-boss": "^12.36.0",
		"posthog-node": "^5.55.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
