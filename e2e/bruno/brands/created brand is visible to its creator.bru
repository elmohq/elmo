meta {
  name: the new brand is reachable by the key that made it
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/brands/{{createdOrgBrandId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

assert {
  res.status: eq 200
  res.body.organizationId: eq default
}
