meta {
  name: an org key cannot name a different owning organization
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/v1/brands
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

script:pre-request {
  bru.setVar("smuggledBrandId", "e2e-smuggled-" + Date.now());
}

body:json {
  {
    "id": "{{smuggledBrandId}}",
    "name": "Smuggled Brand",
    "domains": ["{{smuggledBrandId}}.example.com",
                "{{smuggledBrandId}}.example.net"],
    "organizationId": "{{nikeOrgId}}"
  }
}

assert {
  res.status: eq 201
  res.body.organizationId: eq default
}

tests {
  test("organizationId in the body cannot move the brand out of the key's org", function() {
    expect(res.getBody().organizationId).to.equal("default");
  });
}
