meta {
  name: a brand created with an org key lands in that organization
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/v1/brands
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

script:pre-request {
  bru.setVar("orgBrandId", "e2e-org-brand-" + Date.now());
}

body:json {
  {
    "id": "{{orgBrandId}}",
    "name": "Org Key Brand",
    "domains": ["{{orgBrandId}}.example.com"]
  }
}

assert {
  res.status: eq 201
  res.body.id: eq {{orgBrandId}}
  res.body.organizationId: eq default
}

script:post-response {
  bru.setVar("createdOrgBrandId", res.getBody().id);
}
