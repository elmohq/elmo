meta {
  name: a read-only key cannot update a brand
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgReadOnlyKey}}
}

body:json {
  {
    "brandName": "Renamed by a read-only key"
  }
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains brands:write
}
