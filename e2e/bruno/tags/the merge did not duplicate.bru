meta {
  name: the merge left one tag on three prompts
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/tags
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("the merged-away tag is gone and the survivor is listed once", function() {
    const names = res.getBody().data.map((t) => t.name);
    expect(names).to.not.include("bruno-renamed");
    expect(names.filter((n) => n === "bruno-target").length).to.equal(1);
  });

  test("the survivor now covers every prompt that carried either tag", function() {
    const target = res.getBody().data.find((t) => t.name === "bruno-target");
    expect(target.promptCount).to.equal(3);
  });
}
