meta {
  name: rename a tag across the brand
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/tags/bruno-alpha
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

body:json {
  {
    "name": "bruno-renamed"
  }
}

assert {
  res.status: eq 200
  res.body.name: eq bruno-renamed
  res.body.promptsUpdated: eq 2
}
