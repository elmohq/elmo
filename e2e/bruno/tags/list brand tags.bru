meta {
  name: list the tags in use on a brand
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/tags
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

assert {
  res.status: eq 200
  res.body.brandId: eq default
  res.body.data: isArray
}

tests {
  test("a tag reports how many prompts carry it", function() {
    const byName = Object.fromEntries(res.getBody().data.map((t) => [t.name, t]));
    expect(byName).to.have.property("bruno-alpha");
    expect(byName["bruno-alpha"].promptCount).to.equal(2);
  });

  test("branded and unbranded are the prompt type, not tags, so they are never listed", function() {
    const names = res.getBody().data.map((t) => t.name);
    expect(names).to.not.include("branded");
    expect(names).to.not.include("unbranded");
  });

  test("tags are listed alphabetically", function() {
    const names = res.getBody().data.map((t) => t.name);
    expect(names).to.eql([...names].sort());
  });
}
