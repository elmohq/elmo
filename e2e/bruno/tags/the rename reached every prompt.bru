meta {
  name: the rename reached every prompt that carried it
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/prompts?brandId={{brandId}}&tags=bruno-renamed
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  brandId: {{brandId}}
  tags: bruno-renamed
}

assert {
  res.status: eq 200
  res.body.pagination.total: eq 2
}

tests {
  test("no prompt is left carrying the old tag", function() {
    for (const prompt of res.getBody().prompts) {
      expect(prompt.tags).to.include("bruno-renamed");
      expect(prompt.tags).to.not.include("bruno-alpha");
    }
  });
}
