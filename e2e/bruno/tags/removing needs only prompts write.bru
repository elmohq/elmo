meta {
  name: removing a tag needs only prompts:write
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/tags/bruno-target
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgNoDeleteKey}}
}

assert {
  res.status: eq 200
  res.body.name: isNull
  res.body.promptsUpdated: eq 3
}

tests {
  test("dropping a label is not destroying tracked data", function() {
    expect(res.getStatus(), "a key holding no delete scope may still drop a tag")
      .to.equal(200);
  });
}
