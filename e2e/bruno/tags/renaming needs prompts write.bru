meta {
  name: renaming a tag needs prompts:write
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/tags/bruno-alpha
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgReadOnlyKey}}
}

body:json {
  {
    "name": "bruno-renamed"
  }
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains prompts:write
}
