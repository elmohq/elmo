meta {
  name: another tenant's tag cannot be renamed
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/api/v1/brands/{{nikeBrandId}}/tags/training
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

body:json {
  {
    "name": "stolen"
  }
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
