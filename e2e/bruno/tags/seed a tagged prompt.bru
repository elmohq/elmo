meta {
  name: seed a prompt tagged alpha
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/prompts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

body:json {
  {
    "brandId": "{{brandId}}",
    "value": "Bruno tag fixture alpha",
    "tags": ["bruno-alpha"]
  }
}

assert {
  res.status: eq 201
}
