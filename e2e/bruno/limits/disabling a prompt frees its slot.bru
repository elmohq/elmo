meta {
  name: disabling a prompt frees its slot
  type: http
  seq: 7
  tags: [
    cloud
  ]
}

patch {
  url: {{baseUrl}}/api/v1/prompts/{{cappedPromptId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{cappedKey}}
}

body:json {
  {
    "enabled": false
  }
}

assert {
  res.status: eq 200
  res.body.enabled: isFalsy
}
