meta {
  name: hitting a write limit does not close the data
  type: http
  seq: 13
  tags: [
    cloud
  ]
}

get {
  url: {{baseUrl}}/api/v1/brands/{{cappedBrandId}}/analytics?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{cappedKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 200
}
