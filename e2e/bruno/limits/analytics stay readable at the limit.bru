}

get {
  url: {{baseUrl}}/api/v1/brands/{{cappedBrandId}}/analytics?startDate={{startDate}}&endDate={{endDate}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{cappedKey}}
}

params:query {
  startDate: {{startDate}}
  endDate: {{endDate}}
}

assert {
  res.status: eq 200
}
