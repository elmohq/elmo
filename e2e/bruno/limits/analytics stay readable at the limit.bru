meta {
  name: hitting a write limit does not close the data
  type: http
  seq: 13
  tags: [
    cloud
  ]
}

get {
  url: {{baseUrl}}/api/v1/brands/{{cappedBrandId}}/analytics?start={{windowStart}}&end={{windowEnd}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{cappedKey}}
}

params:query {
  start: {{windowStart}}
  end: {{windowEnd}}
}

assert {
  res.status: eq 200
}
