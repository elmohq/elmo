meta {
  name: re-enabling the disabled prompt now exceeds the plan
  type: http
  seq: 9
  tags: [
    cloud
  ]
}

patch {
  url: {{baseUrl}}/api/v1/prompts/{{cappedPromptId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{cappedKey}}
}

body:json {
  {
    "enabled": true
  }
}

assert {
  res.status: eq 409
  res.body.code: eq prompt_limit
}
