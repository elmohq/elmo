meta {
  name: the deployment reports billing as enabled
  type: http
  seq: 17
  tags: [
    cloud
  ]
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{cappedKey}}
}

assert {
  res.status: eq 200
  res.body.deployment.mode: eq cloud
  res.body.deployment.billingEnabled: isTruthy
}
