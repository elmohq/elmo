meta {
  name: the authorization server advertises its endpoints
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/.well-known/oauth-authorization-server
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("everything a client needs to register and get a token", function() {
    expect(res.body.registration_endpoint).to.contain("/api/auth/oauth2/register");
    expect(res.body.token_endpoint).to.contain("/api/auth/oauth2/token");
  });

  test("the authorization endpoint is the plugin's, which bounces to the page", function() {
    expect(res.body.authorization_endpoint).to.contain("/api/auth/oauth2/authorize");
  });

  test("PKCE is offered, which a public client has to have", function() {
    expect(res.body.code_challenge_methods_supported).to.include("S256");
  });

  test("a public client may present no secret at the token endpoint", function() {
    expect(res.body.token_endpoint_auth_methods_supported).to.include("none");
  });

  test("every URL in the document shares the issuer's origin", function() {
    for (const field of ["authorization_endpoint", "token_endpoint", "registration_endpoint", "jwks_uri"]) {
      expect(res.body[field], field).to.have.string(res.body.issuer);
    }
  });
}

docs {
  A client that finds two fields here naming different origins refuses to
  connect, so a misconfigured APP_URL has to produce one wrong answer to fix
  rather than two that disagree.

  The authorization endpoint is the plugin's own: it is what holds the signed
  request, decides whether consent is still needed, and sends the person to the
  page that asks.
}
