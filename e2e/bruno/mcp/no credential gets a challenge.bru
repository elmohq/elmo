meta {
  name: a request with no credential is told where to authenticate
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/mcp
  body: json
  auth: none
}

headers {
  Accept: application/json, text/event-stream
}

body:json {
  { "jsonrpc": "2.0", "id": 1, "method": "tools/list", "params": {} }
}

assert {
  res.status: eq 401
  res.body.error.code: eq -32001
}

tests {
  test("the refusal is JSON-RPC, so a client parses it like any other reply", function() {
    expect(res.body.jsonrpc).to.equal("2.0");
  });

  test("the challenge points at the protected-resource document", function() {
    expect(res.getHeader("www-authenticate")).to.contain("resource_metadata=");
  });

  test("a browser client can read that header", function() {
    expect(res.getHeader("access-control-expose-headers")).to.contain("WWW-Authenticate");
  });
}

docs {
  This header is the whole of MCP's auth discovery: without it a client that
  has never been configured has nowhere to go, and reports the server as
  simply unreachable.
}
