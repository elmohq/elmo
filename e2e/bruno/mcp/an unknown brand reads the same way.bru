meta {
  name: an unknown brand reads the same way
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/mcp
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
  Accept: application/json, text/event-stream
  mcp-protocol-version: 2025-06-18
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": { "name": "get_brand", "arguments": { "brandId": "no-such-brand-anywhere" } }
  }
}

assert {
  res.status: eq 200
  res.body.result.isError: eq true
}

tests {
  test("indistinguishable from a brand another tenant holds", function() {
    expect(res.body.result.content[0].text).to.contain("not found");
  });
}
