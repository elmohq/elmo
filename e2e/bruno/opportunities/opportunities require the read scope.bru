meta {
  name: opportunities require the read scope
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/opportunities
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgNoScopesKey}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains the read scope
}
