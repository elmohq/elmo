meta {
  name: list the platforms this deployment tracks
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/platforms
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

tests {
  test("the model ids the filters accept are listed", function() {
    const ids = res.getBody().data.map((p) => p.id);
    expect(ids).to.include("chatgpt");
    expect(ids).to.include("claude");
  });

  test("each entry says whether it can be tracked grounded", function() {
    for (const platform of res.getBody().data) {
      expect(platform.label).to.be.a("string");
      expect(platform.premiumCapable).to.be.a("boolean");
      expect(platform.configured).to.be.a("boolean");
    }
  });
}
