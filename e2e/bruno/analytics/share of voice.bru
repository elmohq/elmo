meta {
  name: share of voice against tracked competitors
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/share-of-voice?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 200
  res.body.brandName: isString
  res.body.entries: isArray
  res.body.series: isArray
  res.body.totalRuns: gte 1
}

tests {
  test("exactly one entry is the tracked brand, and shares are percentages", function() {
    const entries = res.getBody().entries;
    expect(entries.filter((e) => e.isBrand).length).to.equal(1);
    for (const entry of entries) {
      expect(entry.share).to.be.at.least(0);
      expect(entry.share).to.be.at.most(100);
    }
  });

  test("the seeded competitors show up", function() {
    const names = res.getBody().entries.map((e) => e.name);
    expect(names).to.include("Competitor Alpha");
  });
}
