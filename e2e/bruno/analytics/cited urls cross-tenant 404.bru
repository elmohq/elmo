meta {
  name: another tenant's cited URLs are not found
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/brands/{{nikeBrandId}}/citations/urls?startDate={{startDate}}&endDate={{endDate}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  startDate: {{startDate}}
  endDate: {{endDate}}
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
