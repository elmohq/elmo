meta {
  name: another tenant's analytics are not found
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/brands/{{nikeBrandId}}/analytics?start={{windowStart}}&end={{windowEnd}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  start: {{windowStart}}
  end: {{windowEnd}}
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
