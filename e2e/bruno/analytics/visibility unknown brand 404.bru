meta {
  name: visibility for an unknown brand
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/brands/does-not-exist/visibility?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
