meta {
  name: analytics require analytics:read
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/analytics?startDate={{startDate}}&endDate={{endDate}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgBrandsOnlyKey}}
}

params:query {
  startDate: {{startDate}}
  endDate: {{endDate}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains analytics:read
}
