meta {
  name: analytics:read alone is enough
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/analytics?startDate={{startDate}}&endDate={{endDate}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgAnalyticsOnlyKey}}
}

params:query {
  startDate: {{startDate}}
  endDate: {{endDate}}
}

assert {
  res.status: eq 200
}
