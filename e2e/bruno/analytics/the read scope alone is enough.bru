meta {
  name: the read scope alone is enough
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/analytics?start={{windowStart}}&end={{windowEnd}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgReadOnlyKey}}
}

params:query {
  start: {{windowStart}}
  end: {{windowEnd}}
}

assert {
  res.status: eq 200
}
