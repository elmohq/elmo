meta {
  name: per-prompt results over the window
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/prompt-performance?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.pagination.total: gte 5
}

tests {
  test("mention rates are percentages", function() {
    for (const row of res.getBody().data) {
      expect(row.brandMentionRate).to.be.at.least(0);
      expect(row.brandMentionRate).to.be.at.most(100);
      expect(row.competitorMentionRate).to.be.at.least(0);
      expect(row.competitorMentionRate).to.be.at.most(100);
    }
  });
}
