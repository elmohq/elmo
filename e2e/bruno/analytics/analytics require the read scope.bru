meta {
  name: analytics require the read scope
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/analytics?start={{windowStart}}&end={{windowEnd}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgNoScopesKey}}
}

params:query {
  start: {{windowStart}}
  end: {{windowEnd}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains the read scope
}
