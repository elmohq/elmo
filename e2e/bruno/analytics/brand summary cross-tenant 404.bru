meta {
  name: another tenant's summary is not found
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/brands/{{nikeBrandId}}/summary?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
