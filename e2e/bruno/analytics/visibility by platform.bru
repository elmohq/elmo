meta {
  name: visibility broken down by platform
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/platforms?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

tests {
  test("every seeded platform is accounted for", function() {
    const models = res.getBody().data.map((row) => row.model);
    expect(models).to.include("chatgpt");
    expect(models).to.include("claude");
  });

  test("visibility is a percentage or null, never a bare count", function() {
    for (const row of res.getBody().data) {
      expect(row.runs).to.be.a("number");
      expect(row.visibility === null || (row.visibility >= 0 && row.visibility <= 100)).to.be.true;
    }
  });
}
