meta {
  name: analytics for an unknown brand
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/brands/does-not-exist/analytics?startDate={{startDate}}&endDate={{endDate}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

params:query {
  startDate: {{startDate}}
  endDate: {{endDate}}
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
