meta {
  name: prompt performance paginates
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/api/v1/brands/{{brandId}}/prompt-performance?lookback=1y&page=1&limit=2
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  lookback: 1y
  page: 1
  limit: 2
}

assert {
  res.status: eq 200
  res.body.pagination.limit: eq 2
  res.body.data: length 2
  res.body.pagination.totalPages: gte 3
}
