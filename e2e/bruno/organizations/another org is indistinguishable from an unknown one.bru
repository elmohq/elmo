meta {
  name: another tenant's org reads exactly like one that never existed
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/organizations/definitely-not-an-org
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgNoScopesKey}}
}

assert {
  res.status: eq 404
}

tests {
  test("the two 404s differ only by the id that was asked for", function() {
    const shape = JSON.stringify(res.getBody()).split("definitely-not-an-org").join("<id>");
    expect(shape).to.equal(bru.getVar("scopelessOtherOrgShape"));
  });
}
