meta {
  name: organizations require brands:read
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/organizations
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgAnalyticsOnlyKey}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains brands:read
}
