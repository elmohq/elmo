meta {
  name: runs require the read scope
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{promptId}}/runs/{{runId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgNoScopesKey}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains the read scope
}
