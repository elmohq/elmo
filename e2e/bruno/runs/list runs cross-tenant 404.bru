meta {
  name: another tenant's runs are not found
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{nikePromptId}}/runs?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
