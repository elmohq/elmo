meta {
  name: runs for a prompt that does not exist
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{missingUuid}}/runs?startDate={{startDate}}&endDate={{endDate}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  startDate: {{startDate}}
  endDate: {{endDate}}
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}
