meta {
  name: runs require runs:read
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{promptId}}/runs/{{runId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgAnalyticsOnlyKey}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains runs:read
}
