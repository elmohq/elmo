meta {
  name: the run list stays bounded
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{promptId}}/runs?lookback=1y
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  lookback: 1y
}

assert {
  res.status: eq 200
}

tests {
  test("neither the answer nor the provider payload is inlined in the list", function() {
    for (const run of res.getBody().data) {
      expect(run.answer, "answer text belongs to GET /runs/{id}").to.be.undefined;
      expect(run.rawOutput, "provider payloads are never exposed").to.be.undefined;
    }
  });
}
