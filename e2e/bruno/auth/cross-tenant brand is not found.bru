meta {
  name: an org key cannot read another tenant's brand
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/api/v1/brands/{{nikeBrandId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}

script:post-response {
  bru.setVar("crossTenantBody", JSON.stringify(res.getBody()));
}
