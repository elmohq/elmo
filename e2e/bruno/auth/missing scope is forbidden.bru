meta {
  name: a key without prompts:read cannot list prompts
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/prompts
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgBrandsOnlyKey}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains prompts:read
}
