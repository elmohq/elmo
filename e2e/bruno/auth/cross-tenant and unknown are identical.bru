meta {
  name: an out-of-scope brand is indistinguishable from one that does not exist
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/v1/brands/definitely-not-a-brand
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

assert {
  res.status: eq 404
  res.body.error: eq Not Found
}

tests {
  test("the body is byte-identical to the out-of-scope brand's", function() {
    expect(JSON.stringify(res.getBody())).to.equal(bru.getVar("crossTenantBody"));
  });
}
