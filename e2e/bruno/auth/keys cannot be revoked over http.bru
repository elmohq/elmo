meta {
  name: the key plugin's delete endpoint is not reachable over HTTP
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/auth/api-key/delete
  body: json
  auth: none
}

body:json {
  {
    "keyId": "e2e-apikey-1"
  }
}

assert {
  res.status: eq 403
  res.body.error: eq Forbidden
  res.body.message: contains issued from the dashboard
}

docs {
  Revocation is blocked over HTTP for the same reason creation is: it goes
  through the dashboard, where the org role that may do it is checked.
}
