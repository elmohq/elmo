meta {
  name: deleting a competitor needs the write scope
  type: http
  seq: 24
}

delete {
  url: {{baseUrl}}/api/v1/competitors/{{competitorId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgReadOnlyKey}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains the write scope
}
