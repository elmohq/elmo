meta {
  name: a write scope does not grant a delete
  type: http
  seq: 24
}

delete {
  url: {{baseUrl}}/api/v1/competitors/{{competitorId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgNoDeleteKey}}
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
  res.body.message: contains competitors:delete
}
