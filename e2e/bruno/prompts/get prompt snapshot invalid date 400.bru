meta {
  name: get prompt snapshot invalid date 400
  type: http
  seq: 36
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{promptId}}/snapshot?startDate=2026-13-01&endDate=2026-12-31
  body: none
  auth: inherit
}

params:query {
  startDate: 2026-13-01
  endDate: 2026-12-31
}

assert {
  res.status: eq 400
  res.body.code: eq validation_error
  res.body.message: startsWith startDate
}
