meta {
  name: create a variant
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/prompts
  body: json
  auth: inherit
}

body:json {
  {
    "brandId": "{{brandId}}",
    "value": "Bruno E2E variant — another wording",
    "parentId": "{{promptId}}"
  }
}

assert {
  res.status: eq 201
  res.body.parentId: eq {{promptId}}
}

script:post-response {
  bru.setVar("variantPromptId", res.getBody().id);
}
