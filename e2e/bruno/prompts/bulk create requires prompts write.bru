meta {
  name: bulk create requires prompts:write
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/prompts/bulk
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgReadOnlyKey}}
}

body:json {
  {
    "brandId": "{{brandId}}",
    "prompts": [{ "value": "read-only keys may not create prompts" }]
  }
}

assert {
  res.status: eq 403
  res.body.code: eq insufficient_scope
}
