meta {
  name: get prompt snapshot top-K at the ceiling
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{promptId}}/snapshot?startDate=2000-01-01&endDate=2100-01-01&kMentions=1&kCitations=50
  body: none
  auth: inherit
}

params:query {
  startDate: 2000-01-01
  endDate: 2100-01-01
  kMentions: 1
  kCitations: 50
}

assert {
  res.status: eq 200
}

tests {
  test("each list holds no more than was asked for", function() {
    // The seeded prompt mentions two competitors, so a single entry shows kMentions was honored.
    const body = res.getBody();
    expect(body.mentions.mentionsTopK).to.have.lengthOf(1);
    expect(body.citations.citedUrlsTopK.length).to.be.at.most(50);
  });
}
