meta {
  name: a bulk create naming another tenant's brand
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/api/v1/prompts/bulk
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

body:json {
  {
    "brandId": "{{nikeBrandId}}",
    "prompts": [{ "value": "not mine to create" }]
  }
}

assert {
  res.status: eq 400
  res.body.error: eq Validation Error
  res.body.message: contains not found
}
