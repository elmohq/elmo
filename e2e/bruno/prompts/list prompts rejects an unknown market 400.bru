meta {
  name: list prompts rejects an unknown market 400
  type: http
  seq: 44
}

get {
  url: {{baseUrl}}/api/v1/prompts?brandId={{brandId}}&markets=de_DE
  body: none
  auth: inherit
}

params:query {
  brandId: {{brandId}}
  markets: de_DE
}

assert {
  res.status: eq 400
  res.body.message: contains Unknown market
}
