meta {
  name: a prompt page past the ceiling is rejected
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/api/v1/prompts?limit=5000
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

params:query {
  limit: 5000
}

assert {
  res.status: eq 400
  res.body.code: eq validation_error
}
