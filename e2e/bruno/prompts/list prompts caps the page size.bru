meta {
  name: an unbounded page size is clamped
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/api/v1/prompts?limit=1000
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

params:query {
  limit: 1000
}

assert {
  res.status: eq 200
  res.body.pagination.limit: eq 100
}

tests {
  test("one request cannot pull the whole table", function() {
    expect(res.getBody().prompts.length).to.be.at.most(100);
  });
}
