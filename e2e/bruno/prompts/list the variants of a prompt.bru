meta {
  name: list the variants of a prompt
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/api/v1/prompts?groupId={{seededGroupId}}
  body: none
  auth: inherit
}

params:query {
  groupId: {{seededGroupId}}
}

assert {
  res.status: eq 200
}

tests {
  test("the prompt and its variant come back, and nothing else", function() {
    const ids = res.getBody().data.map((prompt) => prompt.id);
    expect(ids).to.have.members([bru.getEnvVar("promptId"), bru.getVar("variantPromptId")]);
  });
}
