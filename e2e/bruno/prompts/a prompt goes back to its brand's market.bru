meta {
  name: a prompt goes back to its brand's market
  type: http
  seq: 41
}

patch {
  url: {{baseUrl}}/api/v1/prompts/{{marketPromptId}}
  body: json
  auth: inherit
}

body:json {
  {
    "country": null,
    "language": null
  }
}

assert {
  res.status: eq 200
  res.body.country: isNull
  res.body.language: isNull
  res.body.market.country: eq US
  res.body.market.language: eq en
}
