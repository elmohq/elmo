meta {
  name: get prompt snapshot top-K below the range 400
  type: http
  seq: 38
}

get {
  url: {{baseUrl}}/api/v1/prompts/{{promptId}}/snapshot?startDate=2000-01-01&endDate=2100-01-01&kMentions=0
  body: none
  auth: inherit
}

params:query {
  startDate: 2000-01-01
  endDate: 2100-01-01
  kMentions: 0
}

assert {
  res.status: eq 400
  res.body.code: eq validation_error
  res.body.message: startsWith kMentions
}
