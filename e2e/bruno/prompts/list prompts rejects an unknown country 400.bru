meta {
  name: list prompts rejects an unknown country 400
  type: http
  seq: 44
}

get {
  url: {{baseUrl}}/api/v1/prompts?brandId={{brandId}}&countries=Germany
  body: none
  auth: inherit
}

params:query {
  brandId: {{brandId}}
  countries: Germany
}

assert {
  res.status: eq 400
  res.body.message: contains Unsupported country
}
