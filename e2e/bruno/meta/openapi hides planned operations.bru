meta {
  name: the served spec only documents what is built
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/openapi.json
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("nothing marked planned is served", function() {
    const methods = ["get", "post", "put", "patch", "delete"];
    for (const [path, operations] of Object.entries(res.getBody().paths)) {
      for (const [method, operation] of Object.entries(operations)) {
        if (!methods.includes(method)) continue;
        expect(operation["x-elmo-stability"], `${method} ${path}`).to.not.equal("planned");
      }
    }
  });

  test("every documented tag has an operation behind it", function() {
    const methods = ["get", "post", "put", "patch", "delete"];
    const used = new Set();
    for (const operations of Object.values(res.getBody().paths)) {
      for (const [method, operation] of Object.entries(operations)) {
        if (!methods.includes(method)) continue;
        for (const tag of operation.tags || []) used.add(tag);
      }
    }
    for (const tag of res.getBody().tags || []) {
      expect(used, `tag ${tag.name} is documented with nothing under it`).to.include(tag.name);
    }
  });
}
