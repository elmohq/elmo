meta {
  name: the prompts list carries data alongside its shipped key
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/v1/prompts
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("data and prompts are the same list", function() {
    const body = res.getBody();
    expect(body.data).to.be.an("array");
    expect(body.data).to.eql(body.prompts);
  });
}
