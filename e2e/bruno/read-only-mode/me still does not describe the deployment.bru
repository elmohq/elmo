meta {
  name: me still does not describe the deployment
  type: http
  seq: 7
  tags: [
    demo
  ]
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

assert {
  res.status: eq 200
  res.body.keyType: eq admin
}

tests {
  test("read-only is something a write is told, not something a key is told", function() {
    // The refusals in this folder are where a caller learns the deployment
    // accepts no writes. /me describes the key and nothing about the instance.
    expect(res.getBody().deployment).to.be.undefined;
  });
}
