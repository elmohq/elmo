meta {
  name: a demo deployment refuses a bulk create
  type: http
  seq: 6
  tags: [
    demo
  ]
}

post {
  url: {{baseUrl}}/api/v1/prompts/bulk
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

body:json {
  {
    "brandId": "{{brandId}}",
    "prompts": [{ "value": "Demo deployments accept no writes" }]
  }
}

assert {
  res.status: eq 403
  res.body.code: eq read_only
}
