meta {
  name: a demo deployment refuses to create a prompt
  type: http
  seq: 2
  tags: [
    demo
  ]
}

post {
  url: {{baseUrl}}/api/v1/prompts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminKey}}
}

body:json {
  {
    "brandId": "{{brandId}}",
    "value": "Demo deployments accept no writes"
  }
}

assert {
  res.status: eq 403
  res.body.code: eq read_only
}
