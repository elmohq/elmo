meta {
  name: me describes the deployment
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

assert {
  res.status: eq 200
  res.body.deployment.mode: isString
  res.body.deployment.billingEnabled: isBoolean
  res.body.deployment.readOnly: isFalsy
  res.body.rateLimit.limit: isNumber
}
