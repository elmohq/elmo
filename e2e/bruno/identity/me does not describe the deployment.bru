meta {
  name: me does not describe the deployment
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

assert {
  res.status: eq 200
  res.body.rateLimit.limit: isNumber
}

tests {
  test("nothing about the instance leaks through a tenant's key", function() {
    expect(res.getBody().deployment).to.be.undefined;
  });
}
