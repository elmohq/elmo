meta {
  name: get completed report top-K non-numeric 400
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/reports/{{completedReportId}}?kMentions=abc
  body: none
  auth: inherit
}

params:query {
  kMentions: abc
}

assert {
  res.status: eq 400
  res.body.code: eq validation_error
  res.body.message: startsWith kMentions
}
