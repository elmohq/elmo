meta {
  name: generating a report is admin-only
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/reports
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{orgFullKey}}
}

body:json {
  {
    "brandName": "Acme",
    "brandWebsite": "acme.com"
  }
}

assert {
  res.status: eq 403
  res.body.error: eq Forbidden
}
