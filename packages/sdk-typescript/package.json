{
  "name": "@elmohq/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Elmo API",
  "keywords": [
    "api",
    "client",
    "elmohq",
    "sdk",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/elmohq/elmo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elmohq/elmo.git",
    "directory": "packages/sdk-typescript"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./calls": {
      "types": "./dist/calls/index.d.mts",
      "default": "./dist/calls/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/types/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.5.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
