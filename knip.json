{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreWorkspaces": ["packages/ui"],
  "workspaces": {
    ".": {
      "entry": ["turbo.json"],
      "ignoreBinaries": ["playwright", "drizzle-kit"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.{ts,tsx}!", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      "ignore": ["src/stories/_mocks/**"],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@tailwindcss/typography",
        "@fontsource/geist-sans",
        "@base-ui/react",
        "@resvg/resvg-js"
      ]
    },
    "apps/www": {
      "entry": ["scripts/**"],
      "ignoreDependencies": ["shiki", "@resvg/resvg-js"]
    },
    "packages/og": {
      "ignoreDependencies": ["nitro"]
    },
    "packages/lib": {
      "entry": ["scripts/*.mjs"],
      "ignoreDependencies": ["auth"]
    },
    "e2e": {
      "entry": ["*.ts", "tests/**/*.setup.ts"],
      "project": ["**/*.ts"],
      "ignoreBinaries": ["script"]
    }
  }
}
