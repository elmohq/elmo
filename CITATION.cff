    family-names: Rhizor
    email: jared@elmohq.com
repository-code: https://github.com/elmohq/elmo
url: https://www.elmohq.com/
license: MIT
keywords:
  - answer-engine-optimization
  - generative-engine-optimization
  - llm-optimization
  - ai-visibility
  - brand-monitoring
  - seo
